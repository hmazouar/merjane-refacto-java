<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="30 seconds">
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="merjane-api"/>
    <springProperty scope="context" name="logLevelRoot" source="logging.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="logLevelApp" source="logging.level.com.nimbleways.springboilerplate" defaultValue="INFO"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(${LOG_LEVEL_PATTERN:-%5p}) %clr([${appName}]){magenta} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="com.nimbleways.springboilerplate" level="${logLevelApp}" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="${logLevelRoot}">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
